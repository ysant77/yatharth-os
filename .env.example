# Environment
YATHARTH_OS_ENV=development
YATHARTH_OS_DEBUG=true

# Database
YATHARTH_OS_DATABASE_URL=sqlite+aiosqlite:///./yatharth_os.db

# JWT
YATHARTH_OS_JWT_SECRET_KEY=change-me
YATHARTH_OS_JWT_ALGORITHM=HS256
YATHARTH_OS_JWT_EXPIRE_MINUTES=30

# Rate limiting
YATHARTH_OS_RATE_LIMIT_DEFAULT=120/minute
YATHARTH_OS_RATE_LIMIT_AUTH=20/minute
YATHARTH_OS_RATE_LIMIT_CONTACT=5/minute

# SMTP
YATHARTH_OS_SMTP_HOST=smtp.gmail.com
YATHARTH_OS_SMTP_PORT=587
YATHARTH_OS_SMTP_USERNAME=your-email@gmail.com
YATHARTH_OS_SMTP_PASSWORD=your-app-password
YATHARTH_OS_SMTP_FROM_EMAIL=noreply@example.com
YATHARTH_OS_SMTP_FROM_NAME=Yatharth OS

# Notifications
YATHARTH_OS_OWNER_EMAIL=your-email@gmail.com
YATHARTH_OS_CALENDLY_URL=https://calendly.com/your-link